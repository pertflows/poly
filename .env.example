# Copy to .env and adjust. Every value here is optional - the defaults shown
# are what the code uses if you leave a line out.
#
# THIS FILE IS COMMITTED TO GIT. Never put a real key in it. Real values go in
# .env, which is gitignored and exists only on your machine - so it is not on
# GitHub, and editing this template in the GitHub web editor is never the right
# move. Locally:  cp .env.example .env  and edit .env.

# ---- Credentials -----------------------------------------------------------
# Required. The only secret this project needs, because it never touches a
# wallet, an exchange key, or anything that can move money.
# Goes in .env, not here.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Model -----------------------------------------------------------------
POLY_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Forecasting rewards thinking; `high` is
# the sweet spot. Drop to `medium` if cost per scan matters more than accuracy.
POLY_EFFORT=high
# Two-stage forecasting: web-search research, then a blind structured forecast.
# Turning this off roughly halves cost and materially hurts accuracy on
# anything news-driven, because the model is then stuck at its training cutoff.
POLY_RESEARCH=true
POLY_RESEARCH_MAX_SEARCHES=6

# ---- Storage ---------------------------------------------------------------
POLY_DB=./data/poly.db

# ---- Scan scope and cost control -------------------------------------------
# Markets pulled from Gamma before screening.
POLY_MAX_MARKETS=500
# Hard ceiling on Claude forecasts per run. This is your spend limit.
POLY_MAX_FORECASTS=15
POLY_CONCURRENCY=3
# Don't re-forecast the same market within this many days.
POLY_REFRESH_DAYS=7

# ---- Screening -------------------------------------------------------------
# The liquidity band: the floor is "can I fill an order", the ceiling is
# "am I competing with people who do this full time".
POLY_MIN_LIQUIDITY=5000
POLY_MAX_LIQUIDITY=2000000
POLY_MIN_VOLUME=10000
POLY_MIN_DAYS=2
POLY_MAX_DAYS=120
POLY_MAX_SPREAD=0.04
POLY_MIN_PRICE=0.05
POLY_MAX_PRICE=0.95

# ---- Paper trading ---------------------------------------------------------
POLY_BANKROLL=1000
# Minimum edge in probability points to open a position. 0.07 = 7pp.
POLY_MIN_EDGE=0.07
# Fraction of full Kelly. Full Kelly on an *estimated* probability is ruin.
POLY_KELLY_FRACTION=0.25
POLY_MAX_POSITION_PCT=0.05
POLY_MAX_POSITION_ABS=100
POLY_FEE_BPS=0
POLY_SLIPPAGE_BPS=50

# ---- Shrinkage -------------------------------------------------------------
# How much of Claude's disagreement with the market to actually act on, by
# stated confidence. 0 = always trust the market, 1 = always trust Claude.
# These are guesses until `npm run report` has enough resolved forecasts to
# tell you what they should be.
POLY_SHRINK_LOW=0.2
POLY_SHRINK_MEDIUM=0.35
POLY_SHRINK_HIGH=0.5
# Extra multiplier when Claude flags its own knowledge as stale.
POLY_STALE_SHRINK=0.3
